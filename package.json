{
  "name": "screen-buddy",
  "version": "0.1.0",
  "description": "A dedicated system-stats HUD for a secondary display. Borderless, always-on-top, out of the way.",
  "main": "src/main/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "windowed": "electron . --windowed",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1",
    "doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/doctor.ps1",
    "restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restart.ps1",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-shortcut.ps1",
    "probe": "node scripts/probe-sensors.js",
    "displays": "electron scripts/list-displays.js",
    "themes": "node scripts/check-themes.mjs",
    "init-config": "electron scripts/init-config.js",
    "config:list": "node scripts/config-restore.js list",
    "config:restore": "node scripts/config-restore.js restore",
    "config:reset": "node scripts/config-restore.js reset",
    "config:pin": "node scripts/config-restore.js pin"
  },
  "keywords": [
    "hud",
    "system-monitor",
    "sensor-panel",
    "electron",
    "windows"
  ],
  "author": "duboc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/duboc/screen-buddy.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "systeminformation": "^5.23.5"
  },
  "devDependencies": {
    "electron": "^33.2.0"
  }
}
